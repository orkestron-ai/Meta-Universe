      "provenance": { "owner": "urn:mu:universe:acme" }
    }
  ],
  "contracts": [
    {
      "muifType": "Contract",
      "id": "person:contract:hr-disclosure",
      "kind": "KnowledgeDisclosure",
      "purpose": "HR onboarding",
