      "properties": [
        { "name": "person.givenName", "valueType": "string", "required": true },
        { "name": "person.familyName", "valueType": "string", "required": true },
        { "name": "person.birthDate", "valueType": "dateTime", "required": false }
      ]
    }
  ],
  "relationships": [
