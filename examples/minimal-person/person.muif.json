{
  "muif": { "version": "1.0" },
  "metaModel": {
    "id": "urn:mu:metamodel:minimal-person",
    "csn": "examples.minimalPerson",
    "version": "1.0.0",
    "displayName": "Minimal Person Meta-Model"
  },
  "namespaces": ["person"],
  "bundles": [
    { "csn": "person.core", "layers": ["person.core.identity"] }
  ],
  "objects": [
    {
      "muifType": "Object",
      "id": "person:Person",
      "csn": "person.person",
      "kind": "Entity",
