  ],
  "projections": [
    {
      "muifType": "Projection",
      "id": "person:projection:public",
      "subject": "person:Person",
      "context": "Public",
      "purpose": "Public directory listing",
      "fields": ["person.givenName", "person.familyName"],
      "contract": "person:contract:hr-disclosure"
    }
  ],
  "events": [
    {
      "muifType": "Event",
      "id": "person:event:created:1",
      "type": "Lifecycle",
      "subject": "person:Person",
      "occurrenceTime": "2026-01-01T00:00:00Z",
      "assertionTime": "2026-01-02T12:00:00Z",
      "provenance": { "owner": "urn:mu:universe:acme" }
    }
  ],
  "conformance": { "muc": "2.0: Conformant", "mmas": "A4", "mufp": "Level 2" }
}
